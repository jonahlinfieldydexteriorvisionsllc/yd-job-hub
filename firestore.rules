rules_version = '2';

// YD Job Hub security rules.
//
// These are the real enforcement. The checks in firebase-init.js only decide
// what to draw -- anyone can bypass those from the browser console, so nothing
// here may depend on them.
//
// Default posture is DENY: every collection opts in explicitly, so a collection
// added later is locked until someone writes a rule for it.
//
// ---------------------------------------------------------------------------
// THE FIELD-VISIBILITY PROBLEM
//
// Firestore grants access per DOCUMENT, never per field. There is no way to let
// crew read a snow account while hiding its pricing -- they get the whole record
// or nothing. So anything crew must not see lives in a separate 'private'
// subcollection that they simply cannot read:
//
//   snowAccounts/{id}              name, address, lat/lng, area notes,
//                                  trigger inches, service window   -> crew CAN read
//   snowAccounts/{id}/private/*    tier rates, labour rate, salt rates,
//                                  phone, email                     -> owner only
//
//   storms/{id}                    date, accumulation, crew, route  -> crew CAN read
//   storms/{id}/stops/*            arrive/depart, inches, salt      -> crew CAN write
//   storms/{id}/private/*          billing and totals               -> owner only
//
// Crew get the address (they have to drive there) but not the phone number, the
// email, or a single price.
//
// To install: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // The one account allowed to bootstrap itself as owner.
    function OWNER() {
      return 'jonahlinfield@ydexteriorvisions.com';
    }

    function signedIn()       { return request.auth != null; }
    function myUserDocExists(){ return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myUserDoc()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    function isOwner() {
      return signedIn() && myUserDocExists()
        && myUserDoc().role == 'owner' && myUserDoc().active == true;
    }

    function isCrew() {
      return signedIn() && myUserDocExists()
        && myUserDoc().role == 'crew' && myUserDoc().active == true;
    }

    // An admin helps run the business. They work like crew (their own clock,
    // the route, boards shared with them), and the owner gives them, area by
    // area, 'see' or 'change' on the rest:
    //
    //   users/{uid}.access = { jobs, snow, billing, hours, calendars,
    //                          boards, supplies, equipment, contacts }
    //
    // Never theirs, whatever is set: changing anyone's role or access, the
    // owner's Personal calendar (ownerOnly), the QuickBooks tokens, the
    // Problems screen, settling their own shifts or setting their own rate.
    function isAdmin() {
      return signedIn() && myUserDocExists()
        && myUserDoc().role == 'admin' && myUserDoc().active == true;
    }
    // A nested lookup with a default: copes with no access map at all.
    function areaLevel(area) { return myUserDoc().get(['access', area], 'none'); }
    function canSee(area) {
      return isOwner() || (isAdmin() && areaLevel(area) in ['see', 'change']);
    }
    function canChange(area) {
      return isOwner() || (isAdmin() && areaLevel(area) == 'change');
    }

    // Someone who clocks in and works: crew, and admins.
    function isWorker() { return isCrew() || isAdmin(); }
    function isStaff()  { return isOwner() || isWorker(); }

    // ===================================================================
    // users -- roles and pending access requests
    // ===================================================================
    match /users/{uid} {
      // Admins read everyone's record for names (the clock, boards, calendars).
      // Pay rates are not kept here for that reason -- see payRates.
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || isAdmin());

      // Three creates are permitted:
      //  1. owner bootstrap -- the first sign-in by the owner email mints the
      //     owner record. Without it nobody could ever approve anybody, since
      //     approving requires already being an owner.
      //  2. a pending request for your OWN uid -- grants nothing until an
      //     owner changes the role.
      //  3. an owner creating a record for someone else. Without this the
      //     owner could update a crew record but never create one, so a record
      //     that got into a bad state could only be repaired by that person
      //     signing in again. It grants nothing new: an owner already controls
      //     every role.
      allow create: if isOwner() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
             (request.auth.token.email == OWNER()
               && request.resource.data.role == 'owner'
               && request.resource.data.active == true)
             ||
             (request.resource.data.role == 'pending'
               && request.resource.data.active == false)
           ));

      // Only an owner promotes, demotes or deactivates -- and sets an admin's
      // access. A user cannot edit their own record, or 'pending' could
      // simply self-promote and an admin could widen their own access.
      allow update: if isOwner();

      // Never delete; deactivate, so the audit trail survives.
      allow delete: if false;
    }

    // What each worker is paid, per hour, in cents. Apart from the user
    // record because admins read those for names, and Firestore cannot hide
    // one field of a document. Each worker reads their own.
    match /payRates/{uid} {
      allow read:  if canSee('hours') || (isWorker() && request.auth.uid == uid);
      // An admin never sets their own rate.
      allow write: if isOwner() || (canChange('hours') && request.auth.uid != uid);
    }

    // ===================================================================
    // The business side -- the owner, and admins by area
    // Client names, phone numbers, pricing, costs, margins, estimates.
    // ===================================================================
    match /jobs/{docId}      { allow read: if canSee('jobs');      allow write: if canChange('jobs'); }
    match /expenses/{docId}  { allow read: if canSee('jobs');      allow write: if canChange('jobs'); }
    match /estimates/{docId} { allow read: if canSee('jobs');      allow write: if canChange('jobs'); }
    // What the business charges, one entry per priced thing (estimate.js).
    // Prices -- so whoever deals with jobs, never crew.
    match /priceBook/{docId} { allow read: if canSee('jobs');      allow write: if canChange('jobs'); }
    // How estimates are priced (pricing.js): markups, the crew-day rate,
    // profit targets, delivery rates; pricing/claude is the owner's takeoff
    // rules for Claude. Whoever builds estimates reads them; only the owner
    // changes them. pricing/fuel is written by the server (trip.py).
    match /pricing/{docId}   { allow read: if canSee('jobs');      allow write: if isOwner(); }
    match /contacts/{docId}  { allow read: if canSee('contacts');  allow write: if canChange('contacts'); }
    match /prospects/{docId} { allow read: if canSee('contacts');  allow write: if canChange('contacts'); }
    match /equipment/{docId} { allow read: if canSee('equipment'); allow write: if canChange('equipment'); }

    // settings/public holds harmless shared values (rounding rules, company
    // name). 'snow' is the yard the route starts from; 'invoicing' and
    // 'quickbooksMap' are billing's. Everything else is the owner's.
    match /settings/{docId} {
      allow read:  if isOwner() || (isStaff() && docId == 'public')
        || (docId == 'snow' && canSee('snow'))
        || (docId in ['invoicing', 'quickbooksMap', 'invoiceReminders'] && canSee('billing'))
        // Which Supplies item his words mean (supplymatch.js): whoever sees Supplies.
        || (docId == 'supplyAliases' && canSee('supplies'))
        // The services typed in by hand and kept for reuse (app.js
        // rememberService): whoever fills in jobs or contacts.
        || (docId == 'services' && (canSee('jobs') || canSee('contacts')));
      allow write: if isOwner()
        || (docId == 'snow' && canChange('snow'))
        || (docId in ['invoicing', 'quickbooksMap', 'invoiceReminders'] && canChange('billing'))
        || (docId == 'supplyAliases' && canChange('supplies')
            && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['map', 'updatedAt']))
        || (docId == 'services' && (canChange('jobs') || canChange('contacts'))
            && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                 .hasOnly(['custom', 'updatedAt']))
        // The board list the crew read to find Crew-tagged cards on boards
        // they are not on (names and columns only): kept up by whoever may
        // change boards.
        || (docId == 'public' && canChange('boards')
            && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                 .hasOnly(['crewBoards', 'crewBoardsAt']))
        // The machines' names and types (no costs), for the crew's shop board
        // on the Equipment tab (equipment.js publishNames): kept up by
        // whoever may change the machines.
        || (docId == 'public' && canChange('equipment')
            && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                 .hasOnly(['equipmentList', 'equipmentListAt']));
    }

    // ===================================================================
    // Snow -- crew need the route, never the money
    // ===================================================================
    match /snowAccounts/{accountId} {
      allow read:  if isStaff();
      allow write: if canChange('snow');

      // Pricing and client contact details. Crew cannot read this at all.
      // Billing reads it too: a storm cannot be billed without the prices.
      match /private/{docId} {
        allow read:  if canSee('snow') || canSee('billing');
        allow write: if canChange('snow');
      }
    }

    match /storms/{stormId} {
      allow read:  if isStaff();
      // Starting and running a storm is Snow; closing it for billing, and
      // anything on it once closed, is Billing. Snow cannot close a storm or
      // touch (or reopen) one that is closed.
      allow create: if canChange('snow');
      allow update: if canChange('billing')
        || (canChange('snow') && resource.data.status != 'closed' && request.resource.data.status != 'closed');
      allow delete: if canChange('billing')
        || (canChange('snow') && resource.data.status != 'closed');

      // Per stop: arrive, depart, inches measured, salt used, skipped + reason.
      // A subcollection rather than fields on the storm so two crew tapping
      // different stops at the same moment cannot overwrite each other.
      match /stops/{stopId} {
        allow read: if isStaff();

        // The figures on a stop are printed on the owner's storm and billing
        // screens, so a crew write may only put a number (or nothing) in them
        // -- text there would be drawn as HTML on the owner's screen. Absent
        // and null both pass: a new stop or pass carries null depth, salt and
        // miles until the work is done, and older stops may lack a field.
        function numberOrNull(key) {
          return request.resource.data.get(key, null) == null
            || request.resource.data.get(key, null) is number;
        }
        function stopFiguresAreNumbers() {
          return numberOrNull('order') && numberOrNull('pass')
            && numberOrNull('driveMiles') && numberOrNull('inchesCleared')
            && numberOrNull('saltBags') && numberOrNull('saltLbs');
        }

        // Crew may record work on a storm that is still running. Once the owner
        // closes the storm the billing is locked and only they can touch it.
        // The stop id must look like one of ours (account id, maybe '-p2'): it
        // goes into buttons on the owner's screen.
        function stormOpen() {
          return get(/databases/$(database)/documents/storms/$(stormId)).data.status == 'open';
        }
        allow create, update: if canChange('billing')
          || (canChange('snow') && stormOpen())
          || (isWorker()
              && stopId.matches('[A-Za-z0-9_-]+')
              && stopFiguresAreNumbers()
              && get(/databases/$(database)/documents/storms/$(stormId)).data.status == 'open');

        allow delete: if canChange('billing') || (canChange('snow') && stormOpen());
      }

      // Computed billing and totals.
      match /private/{docId} {
        allow read:  if canSee('billing');
        allow write: if canChange('billing');
      }
    }

    // ===================================================================
    // timeEntries -- crew clock themselves in, owner approves
    // ===================================================================
    match /timeEntries/{entryId} {
      allow read: if canSee('hours')
        || (isWorker() && resource.data.uid == request.auth.uid);

      // Settling, pricing or editing someone else's shift: the owner, or an
      // admin given "Crew hours & pay" -- but an admin never their own. Their
      // own shifts go through exactly the same checks as crew.
      function decidesFor(uid) {
        return isOwner() || (canChange('hours') && uid != request.auth.uid);
      }

      // Nobody sets their own wage. Crew record WHEN they worked; what that is
      // worth is stamped by the owner at approval, from the rate on the
      // worker's user record. Without this a crew member could clock in at any
      // rate they liked, and the entry would read as authoritative payroll.
      // The approval fields are barred for the same reason: an entry that
      // arrived already marked approved would skip the queue entirely.
      function crewFieldsOnly() {
        return !request.resource.data.keys().hasAny(
          ['rateCents', 'costCents', 'approvedBy', 'approvedAt', 'paidHours', 'billableHours']);
      }

      // The clock stops a shift nobody clocked out of after so many hours
      // (functions/autoclock.py: the server, so it happens with the phone
      // off or out of signal). The marks it leaves are the server's alone:
      // no phone starts a shift carrying them, or adds, changes or removes
      // them later.
      function autoKeys() {
        return ['autoEnded', 'autoEndedMs', 'autoEndedAt', 'autoLimitHours', 'autoReason', 'autoTold'];
      }
      function noAutoMarks() {
        return !request.resource.data.keys().hasAny(autoKeys());
      }
      function autoMarksKept() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(autoKeys());
      }

      // An ordinary clocked shift settles itself; making the owner confirm
      // every one turns approval into a rubber stamp. Two kinds do not settle:
      //
      //   'manual'  -- typed in afterwards because somebody forgot to clock
      //                in. Nobody watched the clock run, so the times are a
      //                recollection.
      //   over 8h   -- however it was made. At that length a forgotten
      //                clock-out and a genuinely long day look the same, and
      //                the difference is hours of wages.
      //
      // Both are enforced here and not merely in the app, which is why the
      // times are stored as numbers as well as text: rules cannot do
      // arithmetic on a date written as text.
      function durationMs() {
        return request.resource.data.endedMs - request.resource.data.startedMs;
      }
      function shortEnough() {
        return request.resource.data.endedMs is number
          && request.resource.data.startedMs is number
          && durationMs() > 0
          && durationMs() <= 8 * 60 * 60 * 1000;
      }
      function clocked() { return request.resource.data.source == 'clock'; }

      // Our own ids only: 'te' and letters/digits. The id is put into buttons
      // on the owner's screen, and an id chosen to break out of one would run
      // as the owner.
      function goodId() { return entryId.matches('te[a-z0-9]+'); }

      // Nothing ends in the future. Two minutes' slack for a phone clock that
      // runs a little fast.
      function endedInPast() {
        return request.resource.data.endedMs is number
          && request.resource.data.endedMs <= request.time.toMillis() + 2 * 60 * 1000;
      }

      // A crew member creates exactly two kinds of shift:
      //
      //   clocking in    'running', timed by the clock, no end yet. The start
      //                  may be up to 12 hours old, because a phone with no
      //                  signal sends the clock-in when the signal returns.
      //   typed in       'pending' and 'manual' -- always waits for the owner.
      //
      // Nothing is created already settled. A shift written straight in as
      // 'ok' would never have been timed by anything, and it would count as
      // payroll without the owner ever seeing it.
      function crewMayCreate() {
        let d = request.resource.data;
        return (d.status == 'running' && d.source == 'clock'
                && d.endedMs == null
                && d.startedMs is number
                && d.startedMs <= request.time.toMillis() + 2 * 60 * 1000
                && d.startedMs >= request.time.toMillis() - 12 * 60 * 60 * 1000)
          || (d.status == 'pending' && d.source == 'manual'
                && d.startedMs is number && endedInPast()
                && durationMs() > 0 && durationMs() <= 25 * 60 * 60 * 1000);
      }

      // And changes it in exactly these ways. The source and the start can
      // never change on a clocked shift -- otherwise a typed-in shift could be
      // relabelled as clocked, or a clocked one moved earlier, and settle
      // itself as payroll.
      //
      //   running -> running   pausing and resuming
      //   running -> ok        clocking out, if the clock timed it and it is
      //                        under eight hours
      //   running -> pending   clocking out a longer shift
      //   pending -> pending   correcting a typed-in shift before the owner
      //                        decides it -- it stays waiting
      //   stopped by the clock -> ok / pending
      //                        the phone's own clock-out (or break), made
      //                        with no signal BEFORE the clock stopped the
      //                        shift and sent once the signal came back. Only
      //                        an end EARLIER than the clock's, while the
      //                        shift still has the clock's end and is still
      //                        waiting: the real clock-out wins over the
      //                        clock's guess exactly as if it had arrived in
      //                        time. Never a later end, never back to
      //                        running, and nothing once the office has
      //                        changed the times or decided the shift.
      function crewMayChange() {
        let d = request.resource.data;
        let was = resource.data;
        return d.source == was.source && (
          (was.source == 'manual' && was.status == 'pending'
             && d.status == 'pending' && endedInPast()
             && durationMs() > 0 && durationMs() <= 25 * 60 * 60 * 1000)
          || (was.source == 'clock' && was.status == 'running'
             && d.startedMs == was.startedMs
             && ((d.status == 'running' && d.endedMs == null)
                 || (d.status == 'ok' && endedInPast() && shortEnough())
                 || (d.status == 'pending' && endedInPast() && durationMs() > 0)))
          // A storm shift the clock stopped at the last property settles
          // itself ('ok') when it is short -- the phone's own earlier
          // clock-out still wins there, the same way.
          || (was.source == 'clock'
             && (was.status == 'pending' || (was.status == 'ok' && was.get('autoReason', '') == 'storm'))
             && was.get('autoEnded', false) == true
             && was.endedMs is number && was.get('autoEndedMs', null) == was.endedMs
             && d.startedMs == was.startedMs
             && d.endedMs is number && d.endedMs < was.endedMs
             && ((d.status == 'ok' && endedInPast() && shortEnough())
                 || (d.status == 'pending' && endedInPast() && durationMs() > 0)))
        );
      }

      allow create: if decidesFor(request.resource.data.uid)
        || (isWorker()
            && goodId()
            && request.resource.data.uid == request.auth.uid
            && crewMayCreate()
            && crewFieldsOnly()
            && noAutoMarks());

      // Once a shift is 'ok', 'approved' or 'rejected' it is a payroll record
      // and only an owner may touch it -- otherwise a shift could be clocked
      // out short, settle itself, and then be edited longer.
      // "Done for the day" after a break (timeclock.js endBreakDay): the time
      // the break ended, once, on their own shift that ended for a break, and
      // nothing else. It changes no hours and no pay -- it tells the snow bill
      // when to stop counting the break (pausedMinutesAt) -- so it is allowed
      // on a shift already settled, rate stamped and all.
      function breakOver() {
        let d = request.resource.data;
        let was = resource.data;
        return was.get('endedFor', '') == 'break' && !('breakOverAt' in was)
          && d.diff(was).affectedKeys().hasOnly(['breakOverAt'])
          && d.breakOverAt is number && was.endedMs is number
          && d.breakOverAt >= was.endedMs
          && d.breakOverAt <= request.time.toMillis() + 2 * 60 * 1000;
      }

      allow update: if (decidesFor(resource.data.uid)
            && request.resource.data.uid == resource.data.uid)
        || (isWorker()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && crewMayChange()
            && crewFieldsOnly()
            && autoMarksKept())
        || (isWorker() && resource.data.uid == request.auth.uid && breakOver());

      allow delete: if decidesFor(resource.data.uid);
    }

    // ===================================================================
    // labour/before -- the clock's labour on old jobs, added up
    //
    // The office keeps only the recent shifts live (from 1 January of last
    // year); every counted shift from before that is summed per job and per
    // person into this one record, so All Jobs reads one document instead of
    // every shift ever clocked (timeclock.js). It holds hours and wage costs,
    // so it is read by exactly who reads everyone's shifts.
    //
    // Only the owner's device writes the sums. Someone else who settles or
    // changes an old shift -- an admin with Crew hours & pay: Change -- may
    // only mark it out of date, so the owner's device works it out again;
    // they cannot write figures into it.
    // ===================================================================
    match /labour/{docId} {
      allow read: if canSee('hours');
      allow write: if isOwner() && docId == 'before';
      allow update: if canChange('hours') && docId == 'before'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stale', 'staleAt', 'staleBy'])
        && request.resource.data.stale == true
        && request.resource.data.staleAt is number;
    }

    // ===================================================================
    // problems -- what broke, on whose phone
    //
    // Anyone signed in may file one, because the whole point is to hear about
    // a failure on a phone the owner cannot reach. Only the owner may read
    // them: a report carries a stack trace and the screen someone was on, and
    // that is the owner's diagnostic pile, not something crew should browse.
    //
    // Nobody may edit a filed report -- a record of what happened that can be
    // rewritten afterwards is worth nothing. The owner marks one sorted, which
    // is a status change and nothing else.
    // ===================================================================
    match /problems/{docId} {
      allow read:   if isOwner();
      // Id and kind are checked because both are drawn on the owner's
      // Problems screen; anything else could carry script onto it.
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid
        && docId.matches('p[a-z0-9]+')
        && request.resource.data.kind in ['error', 'promise', 'reported'];
      allow update, delete: if isOwner();
    }

    // ===================================================================
    // jobBoard -- the crew-visible half of a job
    //
    // Same field-visibility problem as the snow accounts, same answer. A job
    // record holds the quote, the costs and the margin in one document, and
    // Firestore cannot hide a field, so crew cannot be given the job itself.
    // This is a companion record carrying only what someone needs in order to
    // clock in to the right work and drive to it:
    //
    //   name, address, city, status
    //
    // No price, no phone number, no email, no margin. It is written by the
    // owner's app every time a job is saved, so the list maintains itself and
    // a new job becomes a clock-in option with nothing to remember.
    // ===================================================================
    match /jobBoard/{jobId} {
      allow read:  if isStaff();
      allow write: if canChange('jobs');
    }

    // ===================================================================
    // claudeUsage -- what the Claude features are costing, per day
    //
    // Written only by the server function, which uses the Admin SDK and so
    // bypasses these rules entirely. Readable by the owner so spend can be
    // shown in the app instead of discovered on a statement. No client may
    // write here: a client that could edit the counter could erase its own
    // spending, which defeats the point of having a daily ceiling.
    // ===================================================================
    match /claudeUsage/{day} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ===================================================================
    // changeRequests -- ONE approval queue for everything
    //
    // Deliberately generic. Rather than a bespoke approval flow per feature,
    // any record type files into this one collection:
    //
    //   { type:        'timeEntry' | 'stormStop' | ... ,
    //     targetPath:  'storms/abc/stops/xyz',
    //     requestedBy: uid,
    //     before:      {...},   // what it says now
    //     after:       {...},   // what they are asking for
    //     reason:      'clocked out late',
    //     status:      'pending' | 'approved' | 'rejected' | 'withdrawn',
    //     decidedBy, decidedAt }
    //
    // Approving does NOT let the requester write to the target -- the owner
    // applies the change. That is what keeps a locked storm or an approved
    // timesheet genuinely locked, and it means adding a new approvable thing
    // later needs no new rules.
    // ===================================================================
    match /changeRequests/{reqId} {
      allow read: if isOwner()
        || (isWorker() && resource.data.requestedBy == request.auth.uid);

      // Crew file only for themselves, and always as pending.
      allow create: if isOwner()
        || (isWorker()
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.status == 'pending');

      // Crew may amend or withdraw their own request while it is still pending.
      // They can never decide one -- not even their own.
      allow update: if isOwner()
        || (isWorker()
            && resource.data.requestedBy == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.requestedBy == resource.data.requestedBy
            && request.resource.data.status in ['pending', 'withdrawn']);

      // Kept, not deleted -- the point is the audit trail.
      allow delete: if false;
    }

    // ===================================================================
    // Calendars and boards -- shared per person, chosen by the owner
    //
    // Each document carries a 'visibleTo' array of uids. The owner decides who
    // is on it; a crew member not listed cannot read the calendar at all.
    // ===================================================================
    //
    // An admin given Calendars reads every calendar marked ownerOnly == false
    // (the app asks exactly that question, so the rules can prove it) and,
    // with 'change', adds and edits events on them. Personal is ownerOnly,
    // and so is any calendar the owner marks private. Making, sharing and
    // deleting calendars stays the owner's.
    match /calendars/{calId} {
      allow read: if isOwner()
        || (canSee('calendars') && resource.data.ownerOnly == false)
        || (isWorker() && request.auth.uid in resource.data.visibleTo);
      allow write: if isOwner();

      function sharedCal() {
        return get(/databases/$(database)/documents/calendars/$(calId)).data.get('ownerOnly', true) == false;
      }
      // Ticked under "Who can add & change" on this calendar (Jonah, 12 Oct
      // 2026: "select specific calendars and boards that the guys can
      // change"): adds, edits and deletes its entries, and nothing else.
      function calEditor() {
        return isWorker() && request.auth.uid in
          get(/databases/$(database)/documents/calendars/$(calId)).data.get('editors', []);
      }

      match /events/{eventId} {
        allow read: if isOwner()
          || (canSee('calendars') && sharedCal())
          || (isWorker() && request.auth.uid in
              get(/databases/$(database)/documents/calendars/$(calId)).data.visibleTo);
        allow write: if isOwner() || (canChange('calendars') && sharedCal()) || calEditor();
        // Anyone a calendar is shared with ticks a date of an entry off on
        // My day (calendar.js calTick: done {YYYY-MM-DD: {at, by} | null},
        // stamped with who and when) -- and changes nothing else about it.
        allow update: if isWorker()
          && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calId)).data.visibleTo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'updatedAt', 'updatedBy']);
      }
    }

    // ===================================================================
    // Supplies and suppliers -- what we use and where to buy it. Everyone
    // signed in reads them (that is the point); only the owner edits. No
    // prices are kept here, because crew can read every field.
    // ===================================================================
    // ===================================================================
    // Daily summaries -- each person chooses their own, and switches phone
    // notifications on per device. The server (Admin SDK) does the sending
    // and is not bound by these rules.
    // ===================================================================
    match /digestPrefs/{uid} {
      allow read, write: if isOwner() || (isStaff() && request.auth.uid == uid);
    }
    // The daily summaries as sent (digest.py _keep), read in the app. Each
    // person's own only -- not even the owner reads a crew member's, which
    // is theirs. Written by the server alone.
    match /summaries/{id} {
      allow read: if isStaff() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /pushSubs/{subId} {
      allow read: if isOwner() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create, update: if isStaff() && request.resource.data.uid == request.auth.uid
        && subId.matches('ps[a-f0-9]+');
      allow delete: if isOwner() || (isStaff() && resource.data.uid == request.auth.uid);
    }

    // The crew's page for each booked or in-progress job (crewjobs.js): name,
    // address, phone, site notes, the work and the materials -- never a price
    // (any dollar amount in a note is blanked before it is written). Written
    // by whoever may change jobs, from the same save as jobBoard.
    match /jobCrew/{jobId} {
      allow read: if isStaff();
      allow write: if canChange('jobs');
    }

    // Photos on a job (jobphotos.js; Jonah, 12 Oct 2026: the crew upload
    // photos on the job page, each marked before / during / after, showing
    // who took it). The picture is in Cloud Storage (storage.rules); this is
    // its record. Anyone working sees them and files their own; whoever took
    // one may change its stage or caption and ask for it to be deleted;
    // deleting -- and anything else -- is for whoever may change jobs.
    function photoStage(d) { return d.stage in ['before', 'during', 'after']; }
    function photoCaption(d) { return d.get('caption', '') is string && d.get('caption', '').size() <= 500; }
    match /jobPhotos/{photoId} {
      allow read: if isStaff();
      allow create: if isStaff() && photoId.matches('jp[a-z0-9]+')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() > 0 && request.resource.data.jobId.size() <= 100
        && request.resource.data.path == 'jobPhotos/' + request.resource.data.jobId + '/' + photoId + '.jpg'
        && request.resource.data.get('deleteAsked', null) == null
        && photoStage(request.resource.data) && photoCaption(request.resource.data);
      allow update: if canChange('jobs')
        || (isStaff() && resource.data.by == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stage', 'caption', 'deleteAsked', 'updatedAt'])
            && photoStage(request.resource.data) && photoCaption(request.resource.data));
      allow delete: if canChange('jobs');
    }

    // Notes from the crew to the owner (crewnotes.js; Jonah, 12 Oct 2026:
    // "leave note for jonah ... i get a notification"). Each person writes
    // and reads their own; the owner reads them all and marks them read. The
    // server stamps notifiedAt when it has told him (not bound by these
    // rules).
    match /crewNotes/{noteId} {
      allow read: if isOwner() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.readAt == null && request.resource.data.notifiedAt == null
        && noteId.matches('cn[a-z0-9]+');
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if isOwner();
    }

    match /supplies/{docId} {
      allow read:  if isStaff();
      allow write: if canChange('supplies');
    }
    match /vendors/{docId} {
      allow read:  if isStaff();
      allow write: if canChange('supplies');
    }
    // What each supply costs. A separate collection, not fields on the
    // supply, because the crew can read every supply and Firestore cannot
    // hide one field of a document from them.
    match /supplyPrices/{supplyId} {
      allow read:  if canSee('supplies');
      allow write: if canChange('supplies');
    }

    // A board the owner marks Private (ownerOnly true, Jonah 9 Oct 2026: his
    // To-buy board) is his alone -- an admin's Boards access does not reach
    // it, as a private calendar's does not; only someone it is shared with by
    // name (visibleTo) sees it. Admins ask for "ownerOnly == false" boards,
    // which is why every board carries the field (boards.js marks old ones).
    match /boards/{boardId} {
      allow read: if isOwner()
        || (canSee('boards') && resource.data.ownerOnly == false)
        || (isWorker() && request.auth.uid in resource.data.visibleTo);
      // Who sees a board and who may change its cards are the owner's to set
      // (Jonah, 12 Oct 2026: "only me to mark which boards can be viewed by
      // who") -- or an admin's he gives Board sharing to ("it needs to be an
      // admin access option"). Private, and the auto-share record, stay his
      // alone. Without Board sharing an admin's new board is shared with
      // nobody, and an admin's change to a board never touches who sees it.
      allow create: if isOwner() || (canChange('boards') && request.resource.data.ownerOnly == false
        && (canChange('boardSharing')
            || (request.resource.data.get('visibleTo', []).size() == 0
                && request.resource.data.get('editors', []).size() == 0)));
      allow update: if isOwner()
        || (canChange('boards') && resource.data.ownerOnly == false && request.resource.data.ownerOnly == false
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerOnly', 'autoShared'])
            && (canChange('boardSharing')
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibleTo', 'editors'])));
      allow delete: if isOwner() || (canChange('boards') && resource.data.ownerOnly == false);

      function boardDoc() { return get(/databases/$(database)/documents/boards/$(boardId)).data; }
      function openBoard() { return boardDoc().get('ownerOnly', false) == false; }
      // Ticked under "Who can add & change" on this board: adds, edits and
      // deletes its cards (not the board itself).
      function boardEditor() { return isWorker() && request.auth.uid in boardDoc().get('editors', []); }

      match /cards/{cardId} {
        // A card tagged Crew (the shared label id 'crew') is the crew's from
        // any board, even one they are not on: Crew tasks lists them all
        // (Jonah, 6 Oct). They ask for them with labels array-contains 'crew',
        // which this clause proves. Never on a private board.
        allow read: if isOwner()
          || (canSee('boards') && openBoard())
          || (isWorker() && request.auth.uid in boardDoc().visibleTo)
          || (isWorker() && 'crew' in resource.data.labels && openBoard());
        // Crew can move a card they can see and tick its checklist -- and
        // nothing else. Without the field list, "can move a card" would also
        // mean "can rewrite what it says or who it is assigned to". Only the
        // owner (or an admin who may change boards) creates or deletes.
        allow update: if isOwner()
          || (canChange('boards') && openBoard())
          || boardEditor()
          || (isWorker()
              && (request.auth.uid in boardDoc().visibleTo
                  || ('crew' in resource.data.labels && openBoard()))
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['column', 'order', 'checklist', 'doneAt', 'updatedAt', 'updatedBy']));
        allow create, delete: if isOwner() || (canChange('boards') && openBoard()) || boardEditor();
      }
    }

    // ===================================================================
    // Receipts -- purchases the server reads out of the owner's email
    // (Admin SDK, not bound by these rules). Whoever may change jobs sorts
    // them, since sorting writes their lines into jobs -- and may change only
    // how a receipt is sorted, never what it says it cost.
    //
    // receiptMail (which emails have already been read) is the server's
    // alone and falls to the deny-all below.
    // ===================================================================
    // ===================================================================
    // invoices -- every unpaid QuickBooks invoice, kept by the server's
    // hourly look (quickbooks.py sync_invoices): when it was emailed, when it
    // is due, the reminders sent. Billing reads it; a reminder noted by hand
    // (a call, a text), one put off, or the job picked by hand is all anyone
    // writes here.
    // ===================================================================
    match /invoices/{docId} {
      allow read: if canSee('billing');
      allow update: if canChange('billing')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handReminders', 'snoozeUntil', 'jobId', 'jobBy', 'updatedAt'])
        && (!('jobBy' in request.resource.data) || request.resource.data.jobBy in ['hand', 'job', 'name', null]);
    }

    // `auto`: a receipt photo sent for a job is put on it by the sorting
    // device (receipts.js autoSort), which claims it, and says how it went,
    // in that one field.
    match /receipts/{docId} {
      allow read: if canSee('jobs');
      allow update: if canChange('jobs')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['splits', 'status', 'skipWhy', 'skippedBy', 'updatedAt', 'updatedBy', 'auto'])
        && request.resource.data.status in ['new', 'done', 'skipped'];
      allow create: if false;
      allow delete: if isOwner();
    }

    // Paychecks -- money sent from the business's bank to a crew member,
    // read out of the owner's email by the same server run. Pay is Hours,
    // like payRates. Only who it was for (and a note) can be changed here;
    // the amount and date are what the bank said.
    match /paychecks/{docId} {
      allow read: if canSee('hours');
      allow update: if canChange('hours')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid', 'status', 'note', 'updatedAt', 'updatedBy']);
      allow create: if false;
      allow delete: if isOwner();
    }

    // ===================================================================
    // Anything not matched above is denied.
    // ===================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
