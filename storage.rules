rules_version = '2';

// YD Job Hub -- who may read and add files in Cloud Storage.
//
// Job photos (jobphotos.js): jobPhotos/{jobId}/{photoId}.jpg
// and a small copy, {photoId}_t.jpg. Each photo's record (stage, who, when)
// is jobPhotos/{photoId} in Firestore, guarded by firestore.rules.
//
// "Working for the business" is read from the same users/{uid} record that
// firestore.rules uses: an active owner, admin or crew member. Deleting is
// for whoever may change jobs, as in firestore.rules. Everything else is
// refused -- a bucket a stranger with a Google account could fill would be a
// bill, so being signed in is never enough on its own.
//
// Reading Firestore from here needs the Storage service agent to hold the
// "Firebase Rules Firestore Service Agent" role; the Firebase console offers
// that the first time these rules are published there.

service firebase.storage {
  match /b/{bucket}/o {

    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function staff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && me().active == true && me().role in ['owner', 'admin', 'crew'];
    }
    function changesJobs() {
      return staff() && (me().role == 'owner'
        || (me().role == 'admin' && me().get(['access', 'jobs'], 'none') == 'change'));
    }

    // Receipt photos (receipts.py keep_photo): written by the server only,
    // kept with the receipt and sent on to QuickBooks. Seen by whoever may
    // see the receipts -- the owner, or an admin with Jobs (firestore.rules).
    match /receiptPhotos/{file} {
      allow read: if staff() && (me().role == 'owner'
        || (me().role == 'admin' && me().get(['access', 'jobs'], 'none') in ['see', 'change']));
    }

    // Files on calendar entries (calendar.js, Jonah 15 Oct 2026: "add
    // attachments to calendar items"): calendarFiles/{calId}/{eventId}/{file}.
    // Added and removed by whoever may change that calendar's entries, as
    // firestore.rules decide it: the owner, an admin with Calendars "change"
    // on a calendar that is neither private nor Personal (seeOnly), anyone
    // ticked as its editor. Opened by anyone working for the business, as
    // job photos are -- the path is only on the entry, which only those who
    // can see the calendar can read, and an entry moved to the Crew schedule
    // keeps its files where they were.
    function changesCal(calId) {
      return staff() && (me().role == 'owner'
        || (me().role == 'admin' && me().get(['access', 'calendars'], 'none') == 'change'
            && firestore.get(/databases/(default)/documents/calendars/$(calId)).data.get('ownerOnly', true) == false
            && firestore.get(/databases/(default)/documents/calendars/$(calId)).data.get('seeOnly', false) != true)
        || request.auth.uid in firestore.get(/databases/(default)/documents/calendars/$(calId)).data.get('editors', []));
    }
    match /calendarFiles/{calId}/{eventId}/{file} {
      allow read: if staff();
      allow create: if changesCal(calId) && request.resource.size < 25 * 1024 * 1024;
      allow delete: if changesCal(calId);
    }

    // Signed papers (signatures.js): jobDocs/{jobId}/{uid}/{docId}.pdf, made
    // on the phone that collected the signature and written once. Whoever may
    // see jobs opens any; a crew member the ones they collected.
    match /jobDocs/{jobId}/{uid}/{file} {
      allow read: if staff() && (request.auth.uid == uid || me().role == 'owner'
        || (me().role == 'admin' && me().get(['access', 'jobs'], 'none') in ['see', 'change']));
      allow create: if staff() && request.auth.uid == uid
        && file.matches('sg[a-z0-9]+[.]pdf')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /jobPhotos/{jobId}/{file} {
      allow read: if staff();
      // A photo is shrunk on the phone to well under this; the cap stops a
      // raw 40 MB file or a video from being stored by mistake.
      allow create: if staff()
        && file.matches('jp[a-z0-9]+(_t)?[.]jpg')
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if changesJobs();
    }
  }
}
